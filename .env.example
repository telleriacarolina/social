# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=

# Email provider: resend (default) or ses
EMAIL_PROVIDER=resend

# Resend (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AWS SES (server-side only)
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# AWS credentials should be supplied through the deployment's
# secure environment or AWS credential provider chain.
# Never commit AWS access keys or secret keys here.

# Optional identity verification provider
IDENTITY_VERIFICATION_API_KEY=